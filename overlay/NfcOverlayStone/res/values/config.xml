<resources>
    <!-- List of SKUs where Secure NFC functionality is supported -->
    <string-array name="config_skuSupportsSecureNfc" translatable="false">
    <item>moonstone_p_global</item>
    <item>sunstone_global</item>
</string-array>

    <!-- Set true if Secure NFC functionality supported for all SKUs -->
    <bool name="enable_secure_nfc_support">true</bool>

    <!-- Whether to enable NFC by default on boot or not. -->
    <bool name="enable_nfc_default">false</bool>
</resources>
