# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                                 <mnt_point>            <type>  <mnt_flags and options>                            <fs_mgr_flags>
system                                                  /system                ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
system                                                  /system                erofs   ro                                                   wait,slotselect,logical,first_stage_mount
system_ext                                              /system_ext            ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
system_ext                                              /system_ext            erofs   ro                                                   wait,slotselect,logical,first_stage_mount
product                                                 /product               ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
product                                                 /product               erofs   ro                                                   wait,slotselect,logical,first_stage_mount
vendor                                                  /vendor                ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
vendor                                                  /vendor                erofs   ro                                                   wait,slotselect,logical,first_stage_mount
odm                                                     /odm                   ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
odm                                                     /odm                   erofs   ro                                                   wait,slotselect,logical,first_stage_mount
mi_ext                                                  /mnt/vendor/mi_ext     ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
mi_ext                                                  /mnt/vendor/mi_ext     erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/mi_ext                                      /mi_ext                erofs   ro,bind                                              wait,nofail
system_dlkm                                             /mnt/vendor/system_dlkm     ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
system_dlkm                                             /mnt/vendor/system_dlkm     erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/system_dlkm                                 /system_dlkm                erofs   ro,bind                                              wait,nofail
odm_dlkm                                                /mnt/vendor/odm_dlkm   ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
odm_dlkm                                                /mnt/vendor/odm_dlkm   erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/odm_dlkm                                    /odm_dlkm              erofs   ro,bind                                              wait,nofail
vendor_dlkm                                             /mnt/vendor/vendor_dlkm     ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
vendor_dlkm                                             /mnt/vendor/vendor_dlkm     erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/vendor_dlkm                                 /vendor_dlkm                erofs   ro,bind                                              wait,nofail
mi_product                                              /mnt/vendor/mi_product      ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
mi_product                                              /mnt/vendor/mi_product      erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/mi_product                                  /mi_product                 erofs   ro,bind                                              wait,nofail
my_bigball                                              /mnt/vendor/my_bigball      ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_bigball                                              /mnt/vendor/my_bigball      erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_bigball                                  /my_bigball                 erofs   ro,bind                                              wait,nofail
my_carrier                                              /mnt/vendor/my_carrier      ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_carrier                                              /mnt/vendor/my_carrier      erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_carrier                                  /my_carrier                 erofs   ro,bind                                              wait,nofail
my_engineering                                          /mnt/vendor/my_engineering     ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_engineering                                          /mnt/vendor/my_engineering     erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_engineering                              /my_engineering                erofs   ro,bind                                              wait,nofail
my_heytap                                               /mnt/vendor/my_heytap   ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_heytap                                               /mnt/vendor/my_heytap   erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_heytap                                   /my_heytap              erofs   ro,bind                                              wait,nofail
my_manifest                                             /mnt/vendor/my_manifest     ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_manifest                                             /mnt/vendor/my_manifest     erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_manifest                                 /my_manifest                erofs   ro,bind                                              wait,nofail
my_product                                              /mnt/vendor/my_product      ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_product                                              /mnt/vendor/my_product      erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_product                                  /my_product                 erofs   ro,bind                                              wait,nofail
my_region                                               /mnt/vendor/my_region       ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_region                                               /mnt/vendor/my_region       erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_region                                   /my_region                  erofs   ro,bind                                              wait,nofail
my_stock                                                /mnt/vendor/my_stock   ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount,nofail,readahead_size_kb=128
my_stock                                                /mnt/vendor/my_stock   erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
/mnt/vendor/my_stock                                    /my_stock              erofs   ro,bind                                              wait,nofail
/dev/block/by-name/cust                                 /mnt/vendor/cust       ext4    ro,barrier=1,discard                                 wait,first_stage_mount,nofail,readahead_size_kb=128
/dev/block/by-name/cust                                 /mnt/vendor/cust       erofs   ro                                                   wait,first_stage_mount,nofail
/mnt/vendor/cust                                        /cust                  erofs   ro,bind                                              wait,nofail
/dev/block/by-name/metadata                             /metadata              ext4    noatime,nosuid,nodev,discard,data=journal,commit=1   wait,check,formattable,first_stage_mount,metadata_csum
/dev/block/bootdevice/by-name/persist                   /mnt/vendor/persist    ext4    noatime,nosuid,nodev,barrier=1                       wait,check
/dev/block/bootdevice/by-name/userdata                  /data                  f2fs    noatime,nosuid,nodev,discard,inlinecrypt,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,flush_merge,mode=adaptive    latemount,wait,check,formattable,quota,reservedsize=128M,checkpoint=fs,readahead_size_kb=128
/dev/block/bootdevice/by-name/misc                      /misc                  emmc    defaults                                             defaults
/devices/platform/soc/4784000.sdhci/mmc_host*           /storage/sdcard1       vfat    nosuid,nodev                                         wait,voldmanaged=sdcard1:auto,encryptable=footer
/devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*   /storage/usbotg        vfat    nosuid,nodev                                         wait,voldmanaged=usbotg:auto
/dev/block/bootdevice/by-name/modem                     /vendor/firmware_mnt   vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
/dev/block/bootdevice/by-name/dsp                       /vendor/dsp            ext4    ro,nosuid,nodev,barrier=1                            wait,slotselect
/dev/block/bootdevice/by-name/bluetooth                 /vendor/bt_firmware    vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait,slotselect
