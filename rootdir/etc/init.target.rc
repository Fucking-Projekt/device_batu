import /vendor/etc/init/hw/init.qti.kernel.rc

on early-init
    wait /sys/devices/soc0/soc_id
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.qti.early_init.sh
    setprop ro.soc.model ${ro.vendor.qti.soc_model}

on init
    # Scheduler uclamp
    mkdir /dev/cpuctl/foreground
    mkdir /dev/cpuctl/background
    mkdir /dev/cpuctl/top-app
    mkdir /dev/cpuctl/rt
    chown system system /dev/cpuctl
    chown system system /dev/cpuctl/foreground
    chown system system /dev/cpuctl/background
    chown system system /dev/cpuctl/top-app
    chown system system /dev/cpuctl/rt
    chown system system /dev/cpuctl/tasks
    chown system system /dev/cpuctl/foreground/tasks
    chown system system /dev/cpuctl/background/tasks
    chown system system /dev/cpuctl/top-app/tasks
    chown system system /dev/cpuctl/rt/tasks
    chmod 0664 /dev/cpuctl/tasks
    chmod 0664 /dev/cpuctl/foreground/tasks
    chmod 0664 /dev/cpuctl/background/tasks
    chmod 0664 /dev/cpuctl/top-app/tasks
    chmod 0664 /dev/cpuctl/rt/tasks
    write /dev/cpuctl/foreground/cpu.rt_runtime_us 950000
    write /dev/cpuctl/background/cpu.rt_runtime_us 950000
    write /dev/cpuctl/top-app/cpu.rt_runtime_us 950000
    write /dev/cpuctl/rt/cpu.rt_runtime_us 950000

    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start logd

    chmod 666 /sys/module/camera/drivers/platform:CAM-FLASH-DRIVER/5c1b000.qcom,cci0:qcom,camera-flash@0/ktd2691_flash

    # Touchscreen
    chown system system /sys/devices/platform/soc/4c88000.i2c/i2c-2/2-0038/fts_gesture_mode
    chmod 0664 /sys/devices/platform/soc/4c88000.i2c/i2c-2/2-0038/fts_gesture_mode

    copy_per_line /dev/cpuctl/tasks /dev/cpuctl/system/tasks

on early-fs
    start vold

on fs
    start hwservicemanager
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/wlan 0700 system system
    chmod 0700 /mnt/vendor/persist/wlan

    mkdir /mnt/rescue 0771 system system
    mount ext4 /dev/block/platform/soc/4804000.ufshc/by-name/rescue /mnt/rescue noatime
    chown system system /mnt/rescue
    chmod 0771 /mnt/rescue
    
on post-fs
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864

on late-fs
    wait_for_prop hwservicemanager.ready true
    #exec_start wait_for_keymaster
    mount_all --late

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system

    #zhangxiaodan To create thermal and config directories, you must first create thermal and then create config
    mkdir /data/vendor/.tp/ 0775 system system
    mkdir /data/vendor/thermal 0771 root system
    mkdir /data/vendor/thermal/config 0771 root system

   #QCC mode configuration
    setprop vendor.qti.qdma.oper.mode 3
    
on early-boot
    swapon_all /vendor/etc/fstab.default
    start vendor.sensors
    # M17-T code for HQ-267809 by dongshuai at 2022.12.8 start
     verity_update_state
    # M17-T code for HQ-267809 by dongshuai at 2022.12.8 end

    # Enable WLAN cold boot calibration
    write /sys/devices/platform/soc/b0000000.qcom,cnss-qca6490/fs_ready 1

# add pcbaconfig by Rimaki
service pcbaconfig /vendor/bin/init.pcba.sh
    class core
    user root
    group root system vendor_qti_diag
    oneshot
    seclabel u:r:vendor_qti_init_shell:s0

on boot
    chown system system /sys/class/drm/card0-DSI-1/doze_brightness
    chmod 0664 /sys/class/drm/card0-DSI-1/doze_brightness
    chown system system /sys/class/drm/card0-DSI-1/disp_param
    chmod 0664 /sys/class/drm/card0-DSI-1/disp_param
    chown system system /sys/class/drm/card0-DSI-1/mipi_reg
    chmod 0664 /sys/class/drm/card0-DSI-1/mipi_reg
    chown system system /sys/class/drm/card0-DSI-1/panel_info
    chmod 0444 /sys/class/drm/card0-DSI-1/panel_info

    write /dev/cpuset/audio-app/cpus 1-2
    # Add a cpuset for the camera daemon
    # We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-7
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks
    #USB controller configuration
    setprop vendor.usb.rndis.func.name "gsi"
    setprop vendor.usb.rmnet.func.name "gsi"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss_mdm"
    setprop vendor.usb.controller 4e00000.dwc3
    chmod 0777 /sys/bus/coresight/devices/coresight-tmc-etr/block_size
    chmod 0777 /dev/byte-cntr

    mkdir /dev/cpuset/surfaceflinger
    write /dev/cpuset/surfaceflinger/cpus 2-7
    write /dev/cpuset/surfaceflinger/mems 0
    chown system system /dev/cpuset/surfaceflinger
    chown system system /dev/cpuset/surfaceflinger/tasks
    chown system system /dev/cpuset/surfaceflinger/cgroup.procs
    # set surfaceflinger to 0775 so SurfaceFlinger can touch it
    chmod 0775 /dev/cpuset/surfaceflinger
    chmod 0664 /dev/cpuset/surfaceflinger/tasks
    chmod 0664 /dev/cpuset/surfaceflinger/cgroup.procs

    #zhangxiaodan To realize the communication between framework and thermal, we need to implement sys node in kernel
    chown system system /sys/class/thermal/thermal_message/sconfig
    chmod 0664 /sys/class/thermal/thermal_message/sconfig
    chown system system /sys/class/thermal/thermal_message/sconfig
    chmod 0666 /sys/class/thermal/thermal_message/temp_state
    chown system system /sys/class/thermal/thermal_message/temp_state

    # add for fingerprint
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/compatible_all
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/compatible_all
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/irq
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/irq
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/hw_reset
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/hw_reset
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/wakeup_enable
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/wakeup_enable
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/power_ctrl
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/power_ctrl
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/screen
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/screen
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/fingerdown_wait
    chmod 0666 /sys/bus/platform/devices/soc/soc:fpc1020/fingerdown_wait

    # add for ignoring adsp crash
    write /sys/bus/msm_subsys/devices/subsys0/restart_level related

    # add for touchscreen
    chown system system /sys/bus/i2c/drivers/fts_ts/2-0038/fts_edge_mode
    chmod 0666 /sys/bus/i2c/drivers/fts_ts/2-0038/fts_edge_mode
    chown system system /sys/bus/i2c/devices/2-0038/fts_charger_mode
    chmod 0666 /sys/bus/i2c/devices/2-0038/fts_charger_mode
    chown system system /sys/bus/i2c/devices/2-0038/fts_rw_reg
    chmod 0666 /sys/bus/i2c/devices/2-0038/fts_rw_reg

    chmod 0666 /dev/goodix_fp
    chown system system /dev/goodix_fp
    # add perm for calib
    mkdir /mnt/vendor/persist/camera 0777 system system
    chmod 0777 /data/vendor/camera
    chmod 0666 /mnt/vendor/persist/camera/rear_dc_cal_wd.bin
    chmod 0666 /data/vendor/camera/com.xiaomi.dcal.wu.data

    #touch funtions permissions setting
    chown system system /sys/class/touch/touch_dev/palm_sensor
    chmod 0664 /sys/class/touch/touch_dev/palm_sensor

    # Health
    chown system system /sys/class/power_supply/battery/input_suspend
    chmod 0660 /sys/class/power_supply/battery/input_suspend

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

on property:vendor.display.lcd_density=560
   setprop dalvik.vm.heapgrowthlimit 256m

on property:vendor.display.lcd_density=640
   setprop dalvik.vm.heapgrowthlimit 512m

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}

on charger
    start vendor.power_off_alarm
    start mi_thermald

#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

#Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service adsprpcd /vendor/bin/adsprpcd
   class main
   user media
   group media
   disabled

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    class core
    oneshot

on property:sys.boot.hwc=*
    setprop ro.boot.hwc ${sys.boot.hwc}
on property:sys.boot.cpuid=*
    setprop ro.boot.cpuid ${sys.boot.cpuid}

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

service mi_thermald /system/vendor/bin/mi_thermald
    class main
    user root
    group system
    seclabel u:r:mi_thermald:s0

service svi_on /vendor/bin/ppd "svi:on"
    class main
    group root system
    oneshot
    disabled

on property:ro.vendor.display.svi=1 && property:sys.boot_completed=1
    start svi_on

on property:ro.boot.hwname=*
    setprop ro.boot.product.hardware.sku ${ro.boot.hwname}

service solo_oslo /system/bin/sh -c " \
    device_config put app_cloning cloned_apps_enabled true; \
    device_config put app_cloning delete_all_app_clones_enabled true; \
    device_config put app_cloning enable_app_cloning_building_blocks true; \
    device_config put attention_manager_service keep_screen_on_enabled false; \
    device_config put privacy location_access_check_enabled true; \
    device_config put privacy location_accuracy_enabled true; \
    device_config put privacy location_indicator_settings_enabled true; \
    device_config put privacy location_indicators_enabled true; \
    device_config put privacy location_indicators_show_system true; \
    device_config put privacy location_indicators_small_enabled true; \
    device_config put privacy discrete_history_cutoff_millis 604800000; \
    device_config put privacy permissions_hub_enabled true; \
    device_config put privacy permissions_hub_2_enabled true; \
    device_config put privacy privacy_dashboard_7_day_toggle true; \
    device_config put privacy warning_banner_enabled true; \
    device_config put privacy safety_center_is_enabled true; \
    device_config put privacy safety_protection_enabled true; \
    device_config put wifi shared_connectivity_enabled true; \
    device_config put runtime_native_boot pin_camera false; \
    device_config put storage_native_boot take_over_get_content true; \
    device_config put device_personalization_services AdaptiveAudio__enable_adaptive_audio true; \
    device_config put device_personalization_services AdaptiveAudio__show_promo_notification false; \
    device_config put device_personalization_services AdaptiveAudio__use_silence_detector_state_bug_fix true; \
    device_config put device_personalization_services EchoSmartspace__always_send_weather_to_home_screen true; \
    device_config put device_personalization_services EchoSmartspace__doorbell_when_for_update_time true; \
    device_config put device_personalization_services EchoSmartspace__enable_add_card_explanation_button_on_long_press true; \
    device_config put device_personalization_services EchoSmartspace__enable_consolidated_weather true; \
    device_config put device_personalization_services EchoSmartspace__enable_dimensional_logging true; \
    device_config put device_personalization_services EchoSmartspace__enable_encode_subcard_into_smartspace_target_id true; \
    device_config put device_personalization_services EchoSmartspace__enable_flight_landing_smartspace_aiai true; \
    device_config put device_personalization_services EchoSmartspace__enable_hotel_smartspace_aiai true; \
    device_config put device_personalization_services EchoSmartspace__enable_loud_sound_alert true; \
    device_config put device_personalization_services EchoSmartspace__enable_my_pixel_ambient_data true; \
    device_config put device_personalization_services EchoSmartspace__enable_predictor_expiration true; \
    device_config put device_personalization_services EchoSmartspace__enable_remote_views true; \
    device_config put device_personalization_services EchoSmartspace__enable_remote_views_content_migration true; \
    device_config put device_personalization_services EchoSmartspace__enable_remote_views_hub_mode_timer true; \
    device_config put device_personalization_services EchoSmartspace__enable_remote_views_mobile_hub_mode_timer true; \
    device_config put device_personalization_services EchoSmartspace__enable_settings_highlight true; \
    device_config put device_personalization_services EchoSmartspace__enable_show_on_home_screen_toggle true; \
    device_config put device_personalization_services EchoSmartspace__enable_sports_card_explanation true; \
    device_config put device_personalization_services EchoSmartspace__enable_sports_score_ambient_data false; \
    device_config put device_personalization_services EchoSmartspace__enable_sports_score_background_container true; \
    device_config put device_personalization_services EchoSmartspace__enable_subzero_ambient_data false; \
    device_config put device_personalization_services EchoSmartspace__enable_thing_ambient_data false; \
    device_config put device_personalization_services EchoSmartspace__enable_travel_features_type_merge true; \
    device_config put device_personalization_services EchoSmartspace__enable_trip_bundle_ambient_data false; \
    device_config put device_personalization_services EchoSmartspace__enable_wallet_suggestions false; \
    device_config put device_personalization_services EchoSmartspace__enable_weather_data_extras true; \
    device_config put device_personalization_services EchoSmartspace__enable_weather_reminder_extraction_homescreen true; \
    device_config put device_personalization_services EchoSmartspace__enable_weather_reminder_extraction_lockscreen true; \
    device_config put device_personalization_services EchoSmartspace__enable_weather_removal_as_secondary_card_home true; \
    device_config put device_personalization_services EchoSmartspace__enable_weather_removal_as_secondary_card_lockscreen true; \
    device_config put device_personalization_services EchoSmartspace__loud_sound_snooze_duration_minutes 30; \
    device_config put device_personalization_services EchoSmartspace__loud_sound_test_threshold_db 0; \
    device_config put device_personalization_services EchoSmartspace__loud_sound_test_threshold_duration_seconds 30; \
    device_config put device_personalization_services EchoSmartspace__ring_lockscreen_delay_seconds 0; \
    device_config put device_personalization_services EchoSmartspace__ring_on_aod_only true; \
    device_config put device_personalization_services EchoSmartspace__show_background_switch true; \
    device_config put device_personalization_services EchoSmartspace__smartspace_enable_daily_forecast true; \
    device_config put device_personalization_services EchoSmartspace__smartspace_enable_timely_reminder true; \
    device_config put device_personalization_services Echo__smartspace_doorbell_aiai_loading_screen false; \
    device_config put device_personalization_services Echo__smartspace_doorbell_allowlist_packages 'com.nest.android,com.google.android.apps.chromecast.app,com.ringapp'; \
    device_config put device_personalization_services Echo__smartspace_doorbell_loading_screen_state 4; \
    device_config put device_personalization_services Echo__smartspace_enable_battery_notification_parser true; \
    device_config put device_personalization_services Echo__smartspace_enable_bluetooth_metadata_parser true; \
    device_config put device_personalization_services Echo__smartspace_enable_cross_device_timer true; \
    device_config put device_personalization_services Echo__smartspace_enable_doorbell true; \
    device_config put device_personalization_services Echo__smartspace_enable_earthquake_alert_predictor true; \
    device_config put device_personalization_services Echo__smartspace_enable_echo_settings true; \
    device_config put device_personalization_services Echo__smartspace_enable_echo_unified_settings true; \
    device_config put device_personalization_services Echo__smartspace_enable_eta_lyft true; \
    device_config put device_personalization_services Echo__smartspace_enable_grocery true; \
    device_config put device_personalization_services Echo__smartspace_enable_light_off_predictor true; \
    device_config put device_personalization_services Echo__smartspace_enable_light_predictor false; \
    device_config put device_personalization_services Echo__smartspace_enable_outlook_events false; \
    device_config put device_personalization_services Echo__smartspace_enable_package_delivery true; \
    device_config put device_personalization_services Echo__smartspace_enable_paired_device_predictor true; \
    device_config put device_personalization_services Echo__smartspace_enable_ridesharing_eta true; \
    device_config put device_personalization_services Echo__smartspace_enable_safety_check_predictor true; \
    device_config put device_personalization_services Echo__smartspace_enable_score_ranker WEIGHTED; \
    device_config put device_personalization_services Echo__smartspace_enable_subcard_logging true; \
    device_config put device_personalization_services Echo__smartspace_outlook_event_source_of_truth TEXT_ONLY; \
    device_config put device_personalization_services Echo__smartspace_package_delivery_card_delay_seconds 0; \
    device_config put notification_assistant generate_actions true; \
    device_config put notification_assistant generate_replies true; \
    device_config put device_personalization_services Notification__enable_otp_check_for_default_sms_package true; \
    device_config put device_personalization_services Notification__enable_otp_in_smart_suggestion true; \
    device_config put device_personalization_services NowPlaying__enable_now_playing_lock_screen_update true; \
    device_config put device_personalization_services NowPlaying__enable_now_playing_quick_affordance true; \
    device_config put device_personalization_services NowPlaying__enable_now_playing_quick_settings true; \
    device_config put device_personalization_services Attention__accel_sensor_enabled false; \
    device_config put device_personalization_services Attention__accel_sensor_threshold_mss 0.2; \
    device_config put device_personalization_services Attention__enabled true; \
    device_config put device_personalization_services Attention__margin_horizontal_px 1000; \
    device_config put device_personalization_services Attention__margin_vertical_px 1000; \
    device_config put device_personalization_services Attention__proximity_sensor_enabled false; \
    device_config put device_personalization_services Translate__app_blocklist com.google.android.talk; \
    device_config put device_personalization_services Translate__blue_chip_translate_enabled true; \
    device_config put device_personalization_services Translate__characterset_lang_detection_enabled true; \
    device_config put device_personalization_services Translate__chat_translate_languages 'de,en,es,fr,it,ja,hi,zh,ru,pl,pt,ko,th,tr,nl,zh_Hant,sv,da,vi,ar,fa,no,bn,fil'; \
    device_config put device_personalization_services Translate__copy_to_translate_enabled true; \
    device_config put device_personalization_services Translate__differentiate_simplified_and_traditional_chinese true; \
    device_config put device_personalization_services Translate__disable_translate_without_system_animation false; \
    device_config put device_personalization_services Translate__enable_chronicle_migration true; \
    device_config put device_personalization_services Translate__enable_default_langid_model true; \
    device_config put device_personalization_services Translate__enable_dictionary_langid_detection true; \
    device_config put device_personalization_services Translate__enable_opmv4_service true; \
    device_config put device_personalization_services Translate__enable_settings_backup_restore true; \
    device_config put device_personalization_services Translate__enable_setup_wizard_dialog_v2 true; \
    device_config put device_personalization_services Translate__enable_translate_kit_api_migration false; \
    device_config put device_personalization_services Translate__interpreter_source_languages 'de,en,ja,es,fr,it'; \
    device_config put device_personalization_services Translate__interpreter_target_languages 'de,en,ja,es,fr,it'; \
    device_config put device_personalization_services Translate__replace_auto_translate_copied_text_enabled true; \
    device_config put device_personalization_services Translate__text_to_text_language_list 'vi,ja,fa,ro,nl,mr,mt,ar,ms,it,eo,is,et,es,iw,zh,uk,af,id,ur,mk,cy,hi,el,be,pt,lt,hr,lv,hu,ht,te,de,bg,th,bn,tl,pl,tr,kn,sv,gl,ko,sw,cs,da,ta,gu,ka,sl,ca,sk'; \
    device_config put device_personalization_services Translate__translation_service_enabled true; \
    device_config put device_personalization_services Translate__translator_expiration_enabled true; \
    device_config put device_personalization_services Translate__use_translate_kit_streaming_api true; \
    device_config put device_personalization_services TextClassifierParams__enable_dynamic_kg_collections true; \
    device_config put device_personalization_services TextClassifierParams__enable_location_scorer true; \
    device_config put device_personalization_services TextClassifierParams__enable_superpacks_custom_bin_processing true; \
    device_config put device_personalization_services TextClassifierParams__enable_superpacks_multi_bulks_request true; \
    device_config put device_personalization_services TextClassifierParams__max_allowable_bins_requests 0; \
    device_config put device_personalization_services TextClassifierParams__max_allowable_local_slice_size 0; \
    device_config put device_personalization_services TextClassifierParams__max_allowable_new_slices_size 95; \
    device_config put device_personalization_services TextClassifierParams__use_vocab_annotator true; \
    device_config put device_personalization_services TextClassifierTcLib__enable_superpacks_kg_actions_ranking true; \
    device_config put device_personalization_services TextClassifierTcLib__enable_tc_easter_egg false; \
    device_config put device_personalization_services TextClassifierTcLib__enable_tc_easter_egg_logging false; \
    device_config put device_personalization_services TextClassifierTcLib__enable_tclib_download_using_superpacks true; \
    device_config put device_personalization_services TextClassifierTcLib__kg_actions_ranking_superpacks_manifest_version 211005; \
    device_config put device_personalization_services TextClassifierTcLib__kg_actions_ranking_superpacks_url_template 'https://gstatic.com/matchmaker/kg_actions_ranking_table/%{VERSION}/superpacks_manifest.zip'; \
    device_config put device_personalization_services TextClassifierTcLib__tclib_actions_superpacks_manifest_url_template 'https://www.gstatic.com/matchmaker/tclib_models/actions/v%{VERSION}/%{LOCALE}/superpacks_manifest.zip'; \
    device_config put device_personalization_services TextClassifierTcLib__tclib_actions_superpacks_manifest_version 104; \
    device_config put device_personalization_services TextClassifierTcLib__tclib_annotator_superpacks_manifest_url_template 'https://www.gstatic.com/matchmaker/tclib_models/annotator/v%{VERSION}/%{LOCALE}/superpacks_manifest.zip'; \
    device_config put device_personalization_services TextClassifierTcLib__tclib_annotator_superpacks_manifest_version 903; \
