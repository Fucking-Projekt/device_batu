service tethergdf /system/bin/sh -c "settings put global tether_offload_disabled 1"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled
    
service phntm /system/bin/sh -c "settings put global settings_enable_monitor_phantom_procs false"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled
    
service hiderror /system/bin/sh -c "settings put global hide_error_dialogs 1"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled

service gms1 /system/bin/sh -c "pm disable com.google.android.gms/com.google.android.gms.auth.managed.admin.DeviceAdminReceiver"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled
    
service gms2 /system/bin/sh -c "pm disable com.google.android.gms/com.google.android.gms.mdm.receivers.MdmDeviceAdminReceiver"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled

service safety1 /system/bin/sh -c "device_config put privacy safety_center_is_enabled true"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled

service safety2 /system/bin/sh -c "device_config put privacy safety_protection_enabled true"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled
    
service dvcsync /system/bin/sh -c "device_config set_sync_disabled_for_tests until_reboot"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled
    
service phntmm /system/bin/sh -c "device_config put activity_manager max_phantom_processes 2147483647"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled

service nonfcyo /system/bin/sh -c "pm disable com.android.nfc"
    seclabel u:r:vendor_qti_init_shell:s0
    user root
    oneshot
    disabled

on property:sys.boot_completed=1
    copy_per_line /dev/cpuctl/tasks /dev/cpuctl/system/tasks
    start dvcsync
    start solo_oslo
    start tethergdf
    start gms1
    start gms2
    start hiderror
    start phntm
    start safety1
    start safety2
    start phntmm
    chmod 440 /proc/net/unix
    write /sys/devices/virtual/thermal/thermal_message/sconfig 15
    chmod 0444 /sys/devices/virtual/thermal/thermal_message/sconfig
    write /dev/cpuctl/background/cpu.uclamp.max 50
    write /dev/cpuctl/system-background/cpu.uclamp.max 50
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 60
    write /dev/cpuctl/background/cpu.shares 1024
    write /dev/cpuctl/system-background/cpu.shares 1024
    write /dev/cpuctl/dex2oat/cpu.shares 512
    write /dev/cpuctl/system/cpu.shares 20480
    write /dev/cpuctl/camera-daemon/cpu.shares 20480
    write /dev/cpuctl/foreground/cpu.shares 20480
    write /dev/cpuctl/nnapi-hal/cpu.shares 20480
    write /dev/cpuctl/rt/cpu.shares 20480
    write /dev/cpuctl/top-app/cpu.shares 20480
    write /sys/block/sda/queue/read_ahead_kb 256
    write /sys/block/sdb/queue/read_ahead_kb 256
    write /sys/block/sdc/queue/read_ahead_kb 256
    write /sys/block/sdd/queue/read_ahead_kb 256
    write /sys/block/sde/queue/read_ahead_kb 256
    write /sys/block/sdf/queue/read_ahead_kb 256

# NFC
on property:sys.boot_completed=1 && property:ro.vendor.hardware.nfc=0
    start nonfcyo
    stop vendor.st_nfc_hal_service
    stop nqnfcinfo
    stop esepmdaemon
