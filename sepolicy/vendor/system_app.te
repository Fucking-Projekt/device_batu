binder_call(system_app, vendor_hal_xiaomi_css)

# Parts
allow system_app sysfs_thermal:file write;

# Fastcharge
allow system_app vendor_sysfs_fastcharge:file { getattr open read write };
allow system_app vendor_sysfs_battery_supply:dir search;
allow system_app vendor_sysfs_battery_supply:file { getattr open read write };

# Kernel Manager
allow system_app sysfs_devices_system_cpu:file { open read write };
allow system_app sysfs_devices_system_cpu:dir search;

# Kcal
allow system_app vendor_sysfs_kcal:dir search;
allow system_app vendor_sysfs_kcal:file rw_file_perms;

# DC Dimming, HBM & FPS Info
allow system_app vendor_sysfs_graphics:dir search;
allow system_app vendor_sysfs_graphics:file rw_file_perms;

# Touch
allow system_app vendor_sysfs_touch:dir search;
allow system_app vendor_sysfs_touch:file rw_file_perms;
